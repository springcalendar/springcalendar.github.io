<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<style>{{ css }}</style>
</head>
<body>
<div class="calendar-page" style="--accent: {{ accent }};">
  <header class="cal-header">
    <div class="cal-head-left">
      {% if logo_uri %}<img class="cal-logo" src="{{ logo_uri }}" alt="">{% endif %}
      <div class="cal-titles">
        <div class="cal-subtitle">{{ subtitle }}</div>
        <h1 class="cal-title">{{ title }}</h1>
      </div>
    </div>
    <div class="cal-month">{{ month_label }}</div>
  </header>

  {% if legend %}
  <div class="cal-legend">
    {% for item in legend %}
    <span class="legend-item"><span class="legend-dot" style="background: {{ item.color }};"></span>{{ item.name }}</span>
    {% endfor %}
  </div>
  {% endif %}

  <div class="cal-grid">
    {% for dow in ["Sun","Mon","Tue","Wed","Thu","Fri","Sat"] %}
    <div class="dow">{{ dow }}</div>
    {% endfor %}

    {% for week in weeks %}
      {% for day in week %}
      <div class="day{% if not day.in_month %} out{% endif %}{% if day.is_today %} today{% endif %}">
        <div class="day-num">{{ day.day }}</div>
        <div class="day-events">
          {% for ev in day.events[:max_per_day] %}
          <div class="chip" style="--chip: {{ ev.color or accent }};">
            {% if not ev.all_day %}<span class="chip-time">{{ ev.start[11:16] }}</span>{% endif %}
            <span class="chip-title">{{ ev.title }}</span>
          </div>
          {% endfor %}
          {% if day.events|length > max_per_day %}
          <div class="more">+{{ day.events|length - max_per_day }} more</div>
          {% endif %}
        </div>
      </div>
      {% endfor %}
    {% endfor %}
  </div>

  <footer class="cal-footer">Generated by Spring Educational Services calendar system</footer>
</div>
</body>
</html>
